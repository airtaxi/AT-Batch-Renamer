<?xml version="1.0" encoding="utf-8" ?>
<views:BaseWindow
    x:Class="BatchRenamerAT.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:BatchRenamerAT.Views"
    x:Uid="SettingsWindow"
    Width="680"
    Height="560"
    MinWidth="480"
    MinHeight="400"
    Closed="OnWindowClosed"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden" Loaded="OnWindowLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnCloseKeyboardAcceleratorInvoked" />
            <KeyboardAccelerator
                Key="W"
                Invoked="OnCloseKeyboardAcceleratorInvoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="SettingsTitleBar"
            Grid.Row="0"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Icon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1" Padding="16,0,16,16">
            <StackPanel Spacing="8">
                <dev:SettingsCard x:Uid="ThemeSettingsCard">
                    <dev:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </dev:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="180" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="ThemeSystemItem" />
                        <ComboBoxItem x:Uid="ThemeLightItem" />
                        <ComboBoxItem x:Uid="ThemeDarkItem" />
                    </ComboBox>
                </dev:SettingsCard>

                <dev:SettingsCard x:Uid="LanguageSettingsCard">
                    <dev:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </dev:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="180" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="LanguageSystemItem" />
                        <ComboBoxItem Content="English" />
                        <ComboBoxItem Content="한국어" />
                        <ComboBoxItem Content="日本語" />
                        <ComboBoxItem Content="简体中文" />
                        <ComboBoxItem Content="繁體中文" />
                    </ComboBox>
                </dev:SettingsCard>

                <InfoBar
                    x:Uid="RestartNoticeInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsRestartNoticeVisible, Mode=OneWay}"
                    Severity="Informational" />

                <dev:SettingsCard x:Uid="FolderHandlingSettingsCard">
                    <dev:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </dev:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="180" SelectedIndex="{x:Bind ViewModel.FolderHandlingIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="FolderHandlingAskItem" />
                        <ComboBoxItem x:Uid="FolderHandlingRenameFoldersItem" />
                        <ComboBoxItem x:Uid="FolderHandlingAddFilesItem" />
                        <ComboBoxItem x:Uid="FolderHandlingAddFilesRecursivelyItem" />
                    </ComboBox>
                </dev:SettingsCard>

                <dev:SettingsCard x:Uid="VersionSettingsCard">
                    <dev:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </dev:SettingsCard.HeaderIcon>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.VersionText}" />
                </dev:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</views:BaseWindow>
