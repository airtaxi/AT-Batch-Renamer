<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseControl
    x:Class="BatchRenamerAT.Controls.TriggerListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BatchRenamerAT.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:BatchRenamerAT.ViewModels"
    Loaded="OnControlLoaded"
    Unloaded="OnControlUnloaded"
    mc:Ignorable="d">

    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.ItemCountText, Mode=OneWay}" />

            <CommandBar
                Grid.Column="1"
                HorizontalAlignment="Right"
                Background="Transparent"
                DefaultLabelPosition="Right">
                <AppBarButton x:Uid="AddTriggerButton" Command="{x:Bind ViewModel.AddCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="EditTriggerButton" Command="{x:Bind ViewModel.EditCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="DeleteTriggerButton" Command="{x:Bind ViewModel.DeleteCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="MoveTriggerUpButton" Command="{x:Bind ViewModel.MoveUpCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74A;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="MoveTriggerDownButton" Command="{x:Bind ViewModel.MoveDownCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74B;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Uid="SaveTriggersButton" Command="{x:Bind ViewModel.SaveTriggersCommand}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74E;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Uid="LoadTriggersButton" Command="{x:Bind ViewModel.LoadTriggersCommand}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8E5;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton x:Uid="DeleteAllTriggersButton" Command="{x:Bind ViewModel.DeleteAllCommand}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE894;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <Grid
            Grid.Row="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <ListView
                x:Name="TriggerListView"
                x:Uid="TriggerListView"
                AllowDrop="True"
                Background="Transparent"
                CanDragItems="True"
                CanReorderItems="True"
                DoubleTapped="OnTriggerListViewDoubleTapped"
                ItemsSource="{x:Bind ViewModel.Items}"
                KeyboardAcceleratorPlacementMode="Hidden"
                SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Delete" Invoked="OnDeleteKeyboardAcceleratorInvoked" />
                    <KeyboardAccelerator Key="Enter" Invoked="OnEditKeyboardAcceleratorInvoked" />
                    <KeyboardAccelerator
                        Key="Up"
                        Invoked="OnMoveUpKeyboardAcceleratorInvoked"
                        Modifiers="Menu" />
                    <KeyboardAccelerator
                        Key="Down"
                        Invoked="OnMoveDownKeyboardAcceleratorInvoked"
                        Modifiers="Menu" />
                </ListView.KeyboardAccelerators>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:TriggerItemViewModel">
                        <Grid Padding="0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                x:Uid="TriggerEnabledCheckBox"
                                Grid.Column="0"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind NumberText, Mode=OneWay}"
                                TextAlignment="Right" />
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Opacity="{x:Bind DescriptionOpacity, Mode=OneWay}"
                                Spacing="2">
                                <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ConditionDescription, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasCondition, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Uid="TriggerListEmptyTextBlock"
                Margin="24,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsHitTestVisible="False"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
        </Grid>
    </Grid>
</controls:BaseControl>
