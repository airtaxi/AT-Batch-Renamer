<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="BatchRenamerAT.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BatchRenamerAT.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:BatchRenamerAT.Pages"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Grid Padding="16,4,16,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="360" />
            <ColumnDefinition Width="6*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:FileListControl Grid.Row="0" />
            <controls:TriggerListControl Grid.Row="1" />
        </Grid>

        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:RenamePreviewControl Grid.Row="0" />

            <!--  Reserves the InfoBar height so opening the result InfoBar does not resize the row  -->
            <Grid
                Grid.Row="1"
                MinHeight="{ThemeResource InfoBarMinHeight}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <InfoBar
                    Title="{x:Bind ViewModel.ResultInfoBarTitle, Mode=OneWay}"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    IsOpen="{x:Bind ViewModel.IsResultInfoBarOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.ResultInfoBarMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.ResultInfoBarSeverity, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            x:Uid="UndoButton"
                            Command="{x:Bind ViewModel.UndoCommand}"
                            Visibility="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Button
                    Grid.Column="1"
                    MinWidth="160"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.RenameCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8AC;" />
                        <TextBlock Text="{x:Bind ViewModel.RenameButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</pages:BasePage>
