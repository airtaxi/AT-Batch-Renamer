<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="BatchRenamerAT.Dialogs.FolderHandlingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="FolderHandlingDialog"
    DefaultButton="Primary"
    Style="{ThemeResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <TextBlock Text="{x:Bind ViewModel.Description}" TextWrapping="Wrap" />

        <RadioButtons SelectedIndex="{x:Bind ViewModel.SelectedModeIndex, Mode=TwoWay}">
            <RadioButton x:Uid="FolderHandlingRenameFoldersRadioButton" />
            <RadioButton x:Uid="FolderHandlingAddFilesRadioButton" />
            <RadioButton x:Uid="FolderHandlingAddFilesRecursivelyRadioButton" />
        </RadioButtons>

        <CheckBox x:Uid="FolderHandlingRememberCheckBox" IsChecked="{x:Bind ViewModel.IsRememberChoiceChecked, Mode=TwoWay}" />
    </StackPanel>
</ContentDialog>
